/node_modules
/.pnp
.pnp.js

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env files (avoid pushing secrets)
.env
.env.*.local
.env.local

# Node Modules
/backend/node_modules/
/frontend/node_modules/

# Vite build output
/dist

# Debugger config files
.vscode/
.idea/
.DS_Store

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini

# MariaDB data directory (if you store any data files locally)
/data

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional parcel-bundler cache (if ever used)
/.cache

# Optional React Native files (not used here but safe to ignore)
/android/
/ios/

# Mac system files
.AppleDouble
.LSOverride
